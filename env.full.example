# Every option Tara reads, with defaults. Copy only what you need into .env.

# --- Automatic meeting memory (docs/adr/0015) ---
TARA_SECTION=default
TARA_AUTO_RECORD=1
TARA_CHUNK_TURNS=6
TARA_EPISODE_RETENTION_DAYS=90
TARA_FACT_RETENTION_DAYS=180
TARA_RECORDER_MODEL=
TARA_DIGEST_TIMEOUT_S=45
TARA_MEETING_TYPE=general
TARA_OPENING_BRIEF=1
TARA_NUDGES=1
TARA_VOCAB_FILE=
TARA_VOCAB=
TARA_HIRING_MODEL=
# Interview: hard per-question limit (retries share it), retries after an incorrect/unclear answer,
# evaluator timeout, and the wait for delayed transcription before saying no answer was heard.
TARA_INTERVIEW_QUESTION_LIMIT_S=180
TARA_INTERVIEW_RETRY_LIMIT=1
TARA_INTERVIEW_EVAL_TIMEOUT_S=20
TARA_INTERVIEW_ANSWER_GRACE_S=2

# --- Google Meet bot (docs/google-meet/GOOGLE_MEET_BOT.md); no credentials here: the bot signs in once by hand with ./dev.sh meet login ---
TARA_MEET_PROFILE_DIR=./work/meet/profile
TARA_MEET_LOCK_DIR=./work/meet/locks
TARA_MEET_BOT_NAME=Tara
TARA_MEET_CHANNEL=chrome
TARA_MEET_HEADLESS=0
TARA_MEET_ADMIT_TIMEOUT_S=600
TARA_MEET_JOIN_TIMEOUT_S=60
TARA_MEET_RECONNECTS=3
# TARA_CHROME_PATH=            # only if Chrome is not in the usual place
TARA_MEET_AUDIO=page                 # page | devices (two virtual cables, see docs/google-meet/GOOGLE_MEET_BOT.md)
TARA_MEET_IN_DEVICE=BlackHole 2ch
TARA_MEET_OUT_DEVICE=BlackHole 16ch
TARA_RESEND_API_KEY=                # email the minutes (docs/meetings/EMAIL_DELIVERY.md); key lives only here
TARA_EMAIL_TO=                      # allow-list of addresses mail may go to, comma separated; empty = email off
TARA_EMAIL_AUTO=0                   # 1 = mail the minutes when each meeting ends
TARA_EMAIL_DRY_RUN=0                # 1 = write to work/email-dry-run instead of sending
TARA_MEET_HALF_DUPLEX=0           # 1 = silence the meeting audio while Tara speaks (stops her hearing her own voice from a speaker)
