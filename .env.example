# Copy to .env (git-ignored) and fill in. Only keys; every other option has a safe default (see env.full.example).

# required: Google AI Studio key
GEMINI_API_KEY=
# required: Gemini Live model id (ai.google.dev/gemini-api/docs/models)
TARA_LIVE_MODEL=
# required for documents and minutes: Gemini Flash text model id
TARA_LLM_MODEL=
# secretary, interviews, documents
TARA_WORK_ENABLED=1
# 1 to remember across meetings (needs PostgreSQL)
TARA_MEMORY_ENABLED=0
# e.g. postgresql:///tara_memory
TARA_MEMORY_DATABASE_URL=
# optional: raises GitHub limit from 60 to 5000 per hour
TARA_GITHUB_TOKEN=
# optional: tavily or brave
TARA_SEARCH_PROVIDER=tavily
# optional: enables web search
TARA_SEARCH_API_KEY=
TARA_TOOLS_SEARCH=0

# optional: section (chat) name; each run is its next numbered meeting (or use ./dev.sh --section NAME)
TARA_SECTION=default

# optional: fast model for meeting summaries (empty = TARA_LLM_MODEL)
TARA_RECORDER_MODEL=

# optional: meeting type (general, standup, one_on_one, retro, client_call, brainstorm)
TARA_MEETING_TYPE=general


TARA_RESEND_API_KEY=re_...
TARA_EMAIL_TO=you@example.com
TARA_EMAIL_FROM=Tara <hello@domaia.dev>
TARA_EMAIL_DRY_RUN=1