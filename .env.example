# Placeholders only. Copy to .env (git-ignored). Planned configuration; see docs/CONFIGURATION.md
GEMINI_API_KEY=
TARA_LLM_PROVIDER=gemini
TARA_LLM_MODEL=            # verify at https://ai.google.dev/gemini-api/docs/models
TARA_STT_BACKEND=
TARA_STT_MODEL=
TARA_TTS_BACKEND=kokoro
TARA_TTS_VOICE=
TARA_MODELS_DIR=./models
TARA_MEETING_ADAPTER=local
TARA_DATA_DIR=./data
PYTORCH_ENABLE_MPS_FALLBACK=1

# --- legacy local-model runtime (DORMANT: Gemini Live is the primary voice path; nothing downloads models) ---
# --- unified runtime (docs/RUNTIME_FOUNDATION.md); placeholders only ---
TARA_GEMINI_ENABLED=0
TARA_CLOUD_CONTEXT_TOKENS=        # operator-set usable cloud context; not assumed
TARA_LOCAL_LLM_BACKEND=mlx_lm
TARA_LOCAL_LLM_MODEL=             # Qwen3-0.6B MLX build repo id or local path (Phase 2)
TARA_LOCAL_CONTEXT_TOKENS=4096
TARA_LOCAL_MAX_TOKENS=160
TARA_MAX_CONCURRENT_INFERENCE=1
TARA_MAX_QUEUE=4
TARA_LOCAL_LLM_TIMEOUT_S=15
TARA_CLOUD_TIMEOUT_S=20
TARA_STT_TIMEOUT_S=30
TARA_TOOL_TIMEOUT_S=10
TARA_LAZY_LOAD=1
TARA_KEEP_MODELS_LOADED=1
TARA_IDLE_UNLOAD_S=0
TARA_ESCALATE_BELOW_CONFIDENCE=0.6
TARA_LOG_LEVEL=INFO

# --- Gemini Live (primary voice engine; docs/GEMINI_LIVE.md) ---
TARA_LIVE_ENABLED=1
# GEMINI_API_KEY is set above; keep the real value only in your private .env or shell
TARA_LIVE_MODEL=                  # REQUIRED: a Live model id from https://ai.google.dev/gemini-api/docs/models (ids change)
TARA_LIVE_VOICE=
TARA_LIVE_CONNECT_TIMEOUT_S=10
TARA_LIVE_RECONNECT_ATTEMPTS=3
TARA_LIVE_RECONNECT_BACKOFF_S=0.5
TARA_LIVE_MAX_SESSIONS=2
TARA_LIVE_HOLD_MS=1500
TARA_LIVE_LOCAL_BARGE_IN=1
TARA_LIVE_RESUMPTION=1
TARA_LIVE_COMPRESSION=1           # without it, audio-only sessions end at about 15 minutes
TARA_LIVE_PROACTIVE_AUDIO=0
TARA_LIVE_HYBRID_EOS=0

# --- Conversational behaviour (docs/CONVERSATIONAL_BEHAVIOUR.md): style only, never permissions ---
TARA_PERSONA_PROFILE=professional      # professional | conversational | expressive (interviews always use professional)
TARA_PERSONA_GUIDANCE=1                # short mid-session style notes to the live model
TARA_PERSONA_GUIDANCE_INTERVAL_S=15
TARA_PERSONA_VOCAL_REACTIONS=0         # brief spoken amusement in ordinary words; non-verbal laughter is not claimed
TARA_PERSONA_FLOOR_WAIT_MS=2500        # wait for a participant who is mid-sentence before speaking
TARA_LIVE_TOOL_BEHAVIOR=default        # default | blocking | non_blocking

# --- Persistent memory (PostgreSQL; docs/MEMORY_AND_RAG.md) ---
# Disabled by default. Use a dedicated database, not an unrelated application's DB.
TARA_MEMORY_ENABLED=0
TARA_MEMORY_DATABASE_URL=               # postgresql://user:password@localhost:5432/tara
TARA_MEMORY_SCHEMA=                     # empty = public; tests use a temporary schema
TARA_MEMORY_SEARCH_LIMIT=5
TARA_MEMORY_CONTEXT_CHARS=1200          # startup memory block cap (not a model limit)
TARA_MEMORY_STARTUP_CONTEXT=1
TARA_MEMORY_WRITE_TIMEOUT_S=3
TARA_MEMORY_RECALL_TIMEOUT_S=2

# --- Orchestration tools (docs/ORCHESTRATION.md); read-only, no shell/filesystem/account access ---
TARA_TOOLS_ENABLED=1
TARA_TOOLS_TIME=1
TARA_TOOLS_CALCULATOR=1
TARA_TOOLS_LOCATION=1
TARA_TOOLS_WEATHER=1
TARA_TOOLS_FETCH=1
TARA_TOOLS_SEARCH=0                    # requires TARA_SEARCH_API_KEY; no live Brave call has been verified yet
TARA_TOOLS_RESEARCH=1                  # only registers when search + fetch are both usable
TARA_TOOLS_BACKGROUND=1
TARA_SEARCH_PROVIDER=brave
TARA_SEARCH_API_KEY=                   # secret; leave empty unless you have a Brave Search plan
TARA_TOOLS_HTTP_TIMEOUT_S=8
TARA_TOOLS_RESEARCH_TIMEOUT_S=25
TARA_TOOLS_RESEARCH_SOURCES=3
TARA_TOOLS_RESEARCH_CHARS=8000
TARA_TOOLS_TASKS=2
TARA_TOOLS_TASK_TTL_S=1800
TARA_TOOLS_MAX_CALLS_PER_TURN=8
TARA_TOOLS_SEARCH_SESSION_LIMIT=8
TARA_TOOLS_WEATHER_CACHE_S=300
TARA_TOOLS_GEOCODE_CACHE_S=86400
TARA_TOOLS_COUNTRY_CACHE_S=604800
TARA_TOOLS_SEARCH_CACHE_S=60
TARA_TOOLS_WEATHER_URL=https://api.open-meteo.com/v1/forecast
TARA_TOOLS_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
TARA_TOOLS_COUNTRY_URL=https://countries.dev
TARA_TOOLS_USER_AGENT=Tara/0.0 (local voice assistant)   # countries.dev rejects the default Python agent
